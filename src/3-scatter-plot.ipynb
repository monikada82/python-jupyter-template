import matplotlib.pyplot as plt

# Data
x = [1, 2, 3, 4, 5]
y = [2, 4, 6, 8, 10]

# Create scatter plot
plt.scatter(x, y)

# Annotate each point with (x, y) values
for i in range(len(x)):
    plt.text(x[i] + 0.1, y[i], f'({x[i]}, {y[i]})')

# Add title
plt.title('Scatter Plot with Annotations')

# Show plot
plt.show()
